# ---------------------------------------------------------------------------
# 生成器副产物
#
# Tools/build_l10n.py 会重建 Resources/*.lproj、Sources/Vantage/L10n*.swift、
# Sources/CProc/cproc_l10n_data.* —— 这些是**需要入库**的生成结果（保证
# swift build 不依赖 Python）。只有下面这个 JSON 是纯调试副产物，不入库。
# ---------------------------------------------------------------------------
Tools/c_l10n_generated.json
Tools/__pycache__/
__pycache__/
*.py[cod]

