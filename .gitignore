# ---------------------------------------------------------------------------
DerivedData/
xcuserdata/
*.xcodeproj/
*.xcworkspace/
*.moved-aside
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100
.Trashes

.vscode

# ---------------------------------------------------------------------------
# 生成器副产物
#
# Tools/build_l10n.py 会重建 Resources/*.lproj、Sources/Vantage/L10n*.swift、
# Sources/CProc/cproc_l10n_data.* —— 这些是**需要入库**的生成结果（保证
# swift build 不依赖 Python）。只有下面这个 JSON 是纯调试副产物，不入库。
# ---------------------------------------------------------------------------
Tools/c_l10n_generated.json
Tools/__pycache__/
__pycache__/
*.py[cod]

# ---------------------------------------------------------------------------
# 编辑器 / 临时文件
# ---------------------------------------------------------------------------
*.swp
*.swo
*~
.idea/
.vscode/
*.log
*.tmp

# ---------------------------------------------------------------------------
# AI 编码助手的工作目录 / 本地状态（各工具的会话、缓存、配置不入库）
#   .claude/    Claude Code          .cursor/   Cursor
#   .codex/     Codex CLI            .gemini/   Gemini CLI
#   .windsurf/  Windsurf             .trae/     Trae
#   .copilot/   GitHub Copilot       .continue/ Continue
#   .codeium/   Codeium              .roo/      Roo Code
#   .cline/     Cline                .kilo/     Kilo Code
#   .serena/    Serena               .workbuddy/ WorkBuddy
#   aider 的会话/配置文件（.aider*, .aider.conf.yml）
# ---------------------------------------------------------------------------
